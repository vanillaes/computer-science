{
  "name": "@vanillaes/computer-science",
  "version": "3.0.0",
  "license": "MIT",
  "author": "Evan Plaice <evanplaice@gmail.com> (http://evanplaice.com/)",
  "description": "Algorithms and Data Structures implemented in modern JS",
  "keywords": [
    "esm",
    "esmodule",
    "algorithms",
    "data-structures",
    "computer-science"
  ],
  "repository": "git@github.com:vanillaes/computer-science",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./src/index.d.ts",
      "browser": "./src/index.min.js"
    }
  },
  "scripts": {
    "test": "esmtk test",
    "test:watch": "esmtk test --watch",
    "lint": "esmtk lint",
    "type": "esmtk type src/index.js",
    "build": "npm run build:min && npm run build:docs && npm run build:typings",
    "build:min": "esmtk minify src/index.js src/index.min.js",
    "build:docs": "node .config/docs.config.js",
    "build:typings": "esmtk typings src/index.js",
    "clean": "npm run clean:docs && npm run clean:typings",
    "clean:docs": "esmtk clean --custom 'docs/*/*.md'",
    "clean:typings": "esmtk clean --typings",
    "preview": "esmtk preview",
    "preversion": "npm test && npm run lint && npm run type",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "@vanillaes/esmtk": "^1.2.3"
  },
  "devDependencies": {
    "docdown": "github:evanplaice/docdown",
    "glob": "^7.2.0"
  }
}
